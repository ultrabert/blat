# Shared access password required to create rooms (not to join).
# Leave empty (or unset) for open local play (anyone can create).
BLAT_PASSWORD=changeme

# Optional: override Colyseus URL for the Vite client in production builds.
# Leave unset when client and server are served from the same origin.
# VITE_COLYSEUS_URL=https://your-app.fly.dev
